<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashRevise.ViewModels"
             x:Class="FlashRevise.Views.Revision.RevisionSessionPage"
             x:DataType="vm:RevisionSessionViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightCanvas}, Dark={StaticResource DarkCanvas}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,10,16,20" RowSpacing="12">

        <!-- En-tête session -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Text="{StaticResource IconClose}" Style="{StaticResource IconButton}" Clicked="OnQuitClicked" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding SubjectName}" Style="{StaticResource LabelStrong}" FontSize="15" />
                <Label Text="{Binding RemainingLabel}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="10,4">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="{StaticResource IconTimer}" FontFamily="MaterialSymbols" FontSize="14"
                           TextColor="{StaticResource Secondary}" />
                    <Label Text="{Binding ElapsedLabel}" Style="{StaticResource ChipLabel}"
                           TextColor="{StaticResource Secondary}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Progression -->
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <ProgressBar Progress="{Binding ProgressRatio}" HeightRequest="6" />
            <Label Text="Répétition espacée · SM-2" Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <!-- Carte -->
        <Border Grid.Row="2" Style="{StaticResource FlashcardSurface}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding FlipCommand}" />
            </Border.GestureRecognizers>

            <ScrollView>
                <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FlipCommand}" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Border Style="{StaticResource Chip}" Padding="10,4" HorizontalOptions="Start">
                        <Label Text="Question" Style="{StaticResource ChipLabel}" TextColor="{StaticResource PrimaryTint}" />
                    </Border>

                    <Label Text="{Binding Question}" Style="{StaticResource Headline}" FontSize="24" LineHeight="1.3" />

                    <BoxView Style="{StaticResource Divider}" Margin="0,4" />

                    <!-- Réponse masquée -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAnswerVisible, Converter={StaticResource InvertBool}}"
                                         Margin="0,24,0,24">
                        <Label Text="{StaticResource IconTouchApp}" FontFamily="MaterialSymbols" FontSize="34"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextMuted}, Dark={StaticResource DarkTextMuted}}" HorizontalOptions="Center" />
                        <Label Text="Touche la carte pour révéler la réponse" Style="{StaticResource Caption}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Réponse -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsAnswerVisible}">
                        <Border Style="{StaticResource Chip}" Padding="10,4" HorizontalOptions="Start"
                                BackgroundColor="{StaticResource TertiaryTint}" Stroke="{StaticResource Tertiary}">
                            <Label Text="Réponse" Style="{StaticResource ChipLabel}" TextColor="{StaticResource Tertiary}" />
                        </Border>
                        <Label Text="{Binding Answer}" Style="{StaticResource BodyLarge}" TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                    </VerticalStackLayout>

                    <!-- Astuce -->
                    <Border BackgroundColor="{StaticResource SecondaryTint}" Stroke="{StaticResource Secondary}"
                            Padding="12" IsVisible="{Binding HasHint}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="{StaticResource IconLightbulb}" FontFamily="MaterialSymbols" FontSize="18"
                                   TextColor="{StaticResource Secondary}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding Hint}" Style="{StaticResource Caption}"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Évaluation -->
        <VerticalStackLayout Grid.Row="3" Spacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsAnswerVisible}">
                <Button Grid.Column="0" Text="Je ne savais pas" Style="{StaticResource RateAgainButton}"
                        HeightRequest="58" Command="{Binding DidntKnowCommand}" />
                <Button Grid.Column="1" Text="Je savais" Style="{StaticResource RateEasyButton}"
                        HeightRequest="58" Command="{Binding KnewCommand}" />
            </Grid>

            <Button Text="Passer cette carte" Style="{StaticResource GhostButton}"
                    Command="{Binding SkipCommand}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasError}"
                    BackgroundColor="{StaticResource DangerTint}" Stroke="{StaticResource Danger}" Padding="10,8">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" TextColor="{StaticResource Danger}" />
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
