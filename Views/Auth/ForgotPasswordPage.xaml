<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashRevise.ViewModels"
             x:Class="FlashRevise.Views.Auth.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightCanvas}, Dark={StaticResource DarkCanvas}}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="12,10">
            <Button Text="{StaticResource IconArrowBack}" Style="{StaticResource IconButton}"
                    Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1" Text="Mot de passe oublié" Style="{StaticResource Title}" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,32" Spacing="16" MaximumWidthRequest="520" HorizontalOptions="Center">

                <Border Style="{StaticResource CardLarge}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Réinitialisation" Style="{StaticResource Overline}" />
                        <Label Text="Entre l'adresse e-mail de ton compte. Si elle correspond à un compte, l'API t'envoie un lien pour choisir un nouveau mot de passe."
                               Style="{StaticResource Body}" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Adresse e-mail" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource InputWrap}">
                                <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="vous@exemple.com"
                                       MaxLength="254" ReturnType="Go" ReturnCommand="{Binding SendCommand}" />
                            </Border>
                        </VerticalStackLayout>

                        <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource DangerTint}"
                                Stroke="{StaticResource Danger}" Padding="12,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding ErrorMessage}" Style="{StaticResource Caption}"
                                   TextColor="{StaticResource Danger}" />
                        </Border>

                        <Border IsVisible="{Binding HasStatusMessage}" BackgroundColor="{StaticResource TertiaryTint}"
                                Stroke="{StaticResource Tertiary}" Padding="12,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                   TextColor="{StaticResource Tertiary}" />
                        </Border>

                        <Grid>
                            <Button Text="Envoyer le lien" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SendCommand}" IsEnabled="{Binding IsNotBusy}" />
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                               Color="White" HorizontalOptions="End" VerticalOptions="Center"
                                               WidthRequest="20" HeightRequest="20" Margin="0,0,16,0"
                                               InputTransparent="True" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Le lien de réinitialisation ouvre une page sécurisée servie par l'API FlashRevise."
                       Style="{StaticResource Caption}" FontSize="11" HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
