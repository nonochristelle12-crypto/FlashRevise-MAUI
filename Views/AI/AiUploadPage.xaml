<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FlashRevise.ViewModels"
             x:Class="FlashRevise.Views.AI.AiUploadPage"
             x:DataType="vm:AiUploadViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightCanvas}, Dark={StaticResource DarkCanvas}}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="12,10">
            <Button Text="{StaticResource IconArrowBack}" Style="{StaticResource IconButton}"
                    Command="{Binding GoBackCommand}" />
            <Label Grid.Column="1" Text="Générer avec l'IA" Style="{StaticResource Title}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="{StaticResource IconSmartToy}" Style="{StaticResource IconButton}"
                    TextColor="{StaticResource Secondary}" Command="{Binding OpenChatCommand}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,32" Spacing="16">

                <!-- Héro IA -->
                <Border Style="{StaticResource CardLarge}" Background="{StaticResource PrimaryGradient}"
                        StrokeThickness="0" Shadow="{StaticResource FloatingShadow}">
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="{StaticResource IconAutoAwesome}" FontFamily="MaterialSymbols" FontSize="22"
                                   TextColor="White" />
                            <Label Text="IA Studio" Style="{StaticResource Overline}" TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="Transforme ton cours en cartes prêtes à réviser." Style="{StaticResource Headline}"
                               FontSize="22" TextColor="White" />
                        <Label Text="Colle un texte, importe un PDF ou scanne une photo : l'IA lit le document et propose des cartes, tu gardes la main sur ce qui est enregistré."
                               Style="{StaticResource Caption}" TextColor="#D9FFFFFF" />
                    </VerticalStackLayout>
                </Border>

                <!-- Clé absente : configuration directe -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoApiKey}"
                        BackgroundColor="{StaticResource WarningTint}" Stroke="{StaticResource Warning}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="{StaticResource IconKey}" Style="{StaticResource Icon}" FontSize="20"
                                   TextColor="{StaticResource Warning}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Aucune clé API configurée. Colle ta clé Groq ci-dessous : elle est enregistrée dans le coffre sécurisé de l'appareil."
                                   Style="{StaticResource Caption}" TextColor="{StaticResource Warning}"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Border Style="{StaticResource InputWrap}">
                            <Entry Text="{Binding ApiKeyInput}" IsPassword="True" Placeholder="gsk_..." />
                        </Border>
                        <Button Text="Enregistrer et tester" Style="{StaticResource PrimaryButton}" HeightRequest="46"
                                Command="{Binding SaveApiKeyCommand}"
                                IsEnabled="{Binding IsTestingKey, Converter={StaticResource InvertBool}}" />
                        <ActivityIndicator IsRunning="{Binding IsTestingKey}" IsVisible="{Binding IsTestingKey}"
                                           Color="{StaticResource Warning}" HeightRequest="24" />
                        <Label Text="{Binding ApiKeyMessage}" IsVisible="{Binding HasApiKeyMessage}"
                               Style="{StaticResource Caption}" TextColor="{StaticResource Warning}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Clé active -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasApiKey}"
                        BackgroundColor="{StaticResource TertiaryTint}" Stroke="{StaticResource Tertiary}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="{StaticResource IconCheckCircle}" Style="{StaticResource Icon}" FontSize="20"
                               TextColor="{StaticResource Tertiary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="IA connectée : ta clé Groq est active sur cet appareil."
                               Style="{StaticResource Caption}" TextColor="{StaticResource Tertiary}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Matières absentes -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasSubjects, Converter={StaticResource InvertBool}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ta première matière" Style="{StaticResource LabelStrong}" />
                        <Label Text="Saisis son nom dans « Matière / nom du paquet » : elle sera créée automatiquement avec les cartes générées."
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Source -->
                <Border Style="{StaticResource CardLarge}">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="{StaticResource IconUploadFile}" Style="{StaticResource Icon}" FontSize="22"
                                   TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Document, scan ou photo" Style="{StaticResource LabelStrong}" />
                                <Label Text="PDF, TXT, MD, CSV, JPG ou PNG" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" IsToggled="{Binding IsFileMode}" VerticalOptions="Center" />
                        </Grid>

                        <!-- Scanner visible en permanence -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Scanner une photo" Style="{StaticResource SecondaryButton}" HeightRequest="46"
                                    Command="{Binding ScanPhotoCommand}" IsVisible="{Binding CanScan}" />
                            <Button Grid.Column="1" Text="Galerie" Style="{StaticResource SecondaryButton}" HeightRequest="46"
                                    Command="{Binding PickPhotoCommand}" />
                        </Grid>
                        <Label Text="Le scanner lit le texte, les formules et le code affichés sur la photo."
                               Style="{StaticResource Caption}" FontSize="11" />

                        <!-- Texte libre -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsFileMode, Converter={StaticResource InvertBool}}">
                            <Border Style="{StaticResource InputWrap}" Padding="12,8">
                                <Editor Text="{Binding SourceText}"
                                        Placeholder="Colle ici le contenu de ton cours, tes notes ou un chapitre…"
                                        AutoSize="TextChanges" HeightRequest="180" MaxLength="20000" />
                            </Border>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Plus le texte est précis, meilleures sont les cartes."
                                       Style="{StaticResource Caption}" />
                                <Label Grid.Column="1" Text="{Binding TextCounter}" Style="{StaticResource Caption}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Fichier -->
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsFileMode}">
                            <Border Style="{StaticResource Card}" Padding="14"
                                    Background="{StaticResource InputSurface}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="{StaticResource IconDescription}" Style="{StaticResource Icon}" FontSize="24"
                                           TextColor="{StaticResource PrimaryTint}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding FileName}"
                                               Style="{StaticResource LabelStrong}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding FileMeta}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="{StaticResource IconClose}" Style="{StaticResource IconButton}"
                                            IsVisible="{Binding HasFile}" Command="{Binding ClearFileCommand}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="0" StrokeThickness="0"
                                    IsVisible="{Binding IsImageSource}">
                                <Image Source="{Binding FilePreviewPath}" HeightRequest="160" Aspect="AspectFill" />
                            </Border>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Text="Choisir un fichier" Style="{StaticResource SecondaryButton}" HeightRequest="46"
                                        Command="{Binding ImportFileCommand}" />
                                <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="10,4" VerticalOptions="Center"
                                        BackgroundColor="{StaticResource SecondaryTint}" Stroke="{StaticResource Secondary}">
                                    <Label Text="{Binding FileBadge}" Style="{StaticResource ChipLabel}"
                                           TextColor="{StaticResource Secondary}" />
                                </Border>
                            </Grid>

                            <ActivityIndicator IsRunning="{Binding IsExtracting}" IsVisible="{Binding IsExtracting}"
                                               Color="{StaticResource Primary}" />
                            <Label Text="Extraction du texte en cours…" Style="{StaticResource Caption}"
                                   IsVisible="{Binding IsExtracting}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Paramètres -->
                <Border Style="{StaticResource CardLarge}">
                    <VerticalStackLayout Spacing="16">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Matière / nom du paquet" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource InputWrap}">
                                <Entry Text="{Binding SubjectNameInput}" MaxLength="80"
                                       Placeholder="Ex. Droit constitutionnel" />
                            </Border>
                            <Label Text="Saisis un nouveau nom pour créer la matière automatiquement."
                                   Style="{StaticResource Caption}" FontSize="11" />
                            <Border Style="{StaticResource InputWrap}" IsVisible="{Binding HasSubjects}">
                                <Picker ItemsSource="{Binding SubjectNames}"
                                        SelectedIndex="{Binding SelectedSubjectIndex}"
                                        Title="Ou choisir une matière existante" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nombre de cartes" Style="{StaticResource Caption}" />
                            <Border Style="{StaticResource InputWrap}">
                                <Picker ItemsSource="{Binding CountLabels}"
                                        SelectedIndex="{Binding SelectedCountIndex}"
                                        Title="Nombre de cartes" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Text="Générer les cartes" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding IsNotBusy}" Command="{Binding GenerateCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}" IsVisible="{Binding HasError}"
                        BackgroundColor="{StaticResource DangerTint}" Stroke="{StaticResource Danger}">
                    <Label Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" TextColor="{StaticResource Danger}" />
                </Border>

                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="{StaticResource IconShield}" Style="{StaticResource Icon}" FontSize="20"
                               TextColor="{StaticResource Tertiary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Tu valides avant d'enregistrer" Style="{StaticResource LabelStrong}" />
                            <Label Text="Les cartes proposées restent modifiables et supprimables. Ta clé API est stockée dans le coffre sécurisé de l'appareil."
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
